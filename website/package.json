{
  "name": "@agentmarkup/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm -C ../packages/vite build",
    "dev": "vite",
    "prebuild": "pnpm -C ../packages/vite build",
    "build": "tsc -b && vite build",
    "smoke": "pnpm build",
    "test": "vitest run",
    "verify:seo": "node scripts/seo-structure.mjs verify",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@agentmarkup/core": "workspace:*",
    "@agentmarkup/vite": "workspace:*",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.11.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.16",
    "vite-prerender-plugin": "^0.5.11",
    "vitest": "^3.2.6"
  }
}
