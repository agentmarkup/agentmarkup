{
  "name": "@agentmarkup/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm -C ../packages/vite build",
    "dev": "vite",
    "prebuild": "pnpm -C ../packages/vite build",
    "build": "tsc -b && vite build",
    "smoke": "pnpm build",
    "pretest": "pnpm -C ../packages/vite build",
    "test": "vitest run",
    "verify:seo": "node scripts/seo-structure.mjs verify",
    "lint": "eslint .",
    "pretypecheck": "pnpm -C ../packages/vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@agentmarkup/core": "workspace:*",
    "@agentmarkup/vite": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-prerender-plugin": "^0.5.14",
    "vitest": "^4.1.12"
  }
}
